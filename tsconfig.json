{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*",
        "./src/api/*",
        "./src/actors/*",
        "./src/actors/web/*",
        "./src/actors/corpus/*",
        "./src/actors/documents/*",
        "./src/browser/*",
        "./src/extractors/*",
        "./src/network/*"
      ]
    }
  },
  "include": ["src/**/*", "tests/**/*", "contracts/**/*"],
  "exclude": ["node_modules", "dist"]
}
