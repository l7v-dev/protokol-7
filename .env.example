NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
SERVICE_NAME=scraping-platform-api
API_VERSION=v1
AUTH_MODE=test
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/scraping_platform
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=scraping:development
STORAGE_MODE=memory
STORAGE_ROOT=/tmp/scraping-platform-storage
