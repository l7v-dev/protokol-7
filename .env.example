# Protokol-7 Environment Configuration

# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Pipedream Connect
# Project ID for Pipedream Connect (Default: proj_zNsBAEe)
PIPEDREAM_PROJECT_ID=proj_zNsBAEe
PIPEDREAM_ENVIRONMENT=production

# Pipedream OAuth Client Credentials
# Create these at https://pipedream.com/projects/proj_zNsBAEe/settings
PIPEDREAM_CLIENT_ID=
PIPEDREAM_CLIENT_SECRET=

# Model Context Protocol (MCP) HTTP Transport
# Optional Bearer token for authenticating POST /mcp and GET /mcp/events requests.
# If omitted or empty, authentication is disabled (development mode).
MCP_API_TOKEN=
