{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "decontaminate-dataset-output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "success",
        "blocked",
        "failed"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "train_checked": {
          "type": "integer",
          "minimum": 0
        },
        "evaluation_checked": {
          "type": "integer",
          "minimum": 0
        },
        "exact_overlaps": {
          "type": "integer",
          "minimum": 0
        },
        "quarantined": {
          "type": "integer",
          "minimum": 0
        },
        "overlap_report_uri": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "train_checked",
        "evaluation_checked",
        "exact_overlaps",
        "quarantined",
        "overlap_report_uri"
      ]
    }
  },
  "required": [
    "status",
    "artifacts",
    "blockers"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "properties": {
          "blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "blocked",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
