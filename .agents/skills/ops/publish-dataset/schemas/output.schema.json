{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "publish-dataset-output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "success",
        "blocked",
        "failed"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "release_state": {
          "enum": [
            "candidate",
            "released",
            "withdrawn"
          ]
        },
        "manifest_uri": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "snapshot_id",
        "release_state",
        "manifest_uri"
      ]
    }
  },
  "required": [
    "status",
    "artifacts",
    "blockers"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "properties": {
          "blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "blocked",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
