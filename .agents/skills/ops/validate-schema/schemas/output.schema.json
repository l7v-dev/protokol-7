{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "validate-schema-output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "success",
        "blocked",
        "failed"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "instance_path": {
                "type": "string"
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "instance_path",
              "message"
            ]
          }
        }
      },
      "required": [
        "valid",
        "errors"
      ]
    }
  },
  "required": [
    "status",
    "artifacts",
    "blockers"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "properties": {
          "blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "blocked",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
