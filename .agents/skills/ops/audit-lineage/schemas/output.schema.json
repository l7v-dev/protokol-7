{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "audit-lineage-output",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "success",
        "blocked",
        "failed"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifests_checked": {
          "type": "integer",
          "minimum": 0
        },
        "occurrences_checked": {
          "type": "integer",
          "minimum": 0
        },
        "missing_links": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checksum_failures": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "manifests_checked",
        "occurrences_checked",
        "missing_links",
        "checksum_failures"
      ]
    }
  },
  "required": [
    "status",
    "artifacts",
    "blockers"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "success"
          }
        }
      },
      "then": {
        "required": [
          "result"
        ],
        "properties": {
          "blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "blocked",
              "failed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
