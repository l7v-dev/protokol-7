{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobNotificationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "job_id",
    "operation",
    "trace_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "operation": {
      "enum": [
        "download",
        "extract",
        "ocr",
        "normalize",
        "publish",
        "embed",
        "export"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    }
  }
}
