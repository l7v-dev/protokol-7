{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "document.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "document.v1"
    },
    "document_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalization_version": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "pii_status": {
      "enum": [
        "unchecked",
        "clear",
        "redacted",
        "quarantined"
      ]
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test",
        "unassigned"
      ]
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "approved",
            "unknown",
            "blocked"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "evidence_uri": {
          "type": "string",
          "format": "uri"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "allowed_purposes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "required": [
              "license",
              "evidence_uri",
              "reviewed_at",
              "allowed_purposes"
            ]
          }
        }
      ]
    },
    "occurrences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_record_id": {
            "type": "string",
            "minLength": 1
          },
          "source_uri": {
            "type": "string",
            "format": "uri"
          },
          "acquired_at": {
            "type": "string",
            "format": "date-time"
          },
          "raw_artifact_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "source_record_id",
          "source_uri",
          "acquired_at",
          "raw_artifact_id"
        ]
      },
      "minItems": 1
    },
    "quality": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "canonicalization_version",
    "text",
    "language",
    "pii_status",
    "split",
    "rights",
    "occurrences"
  ]
}
