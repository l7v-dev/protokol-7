{
  "name": "protokol-7",
  "version": "1.0.0",
  "private": true,
  "description": "Headless Web Scraping, Deep Crawling & Anti-Detection Browser Automation Microservice",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "pipeline": "tsx src/pipeline/cli.ts",
    "build": "tsc",
    "test": "NODE_ENV=test tsx --test 'tests/**/*.test.ts'",
    "lint": "biome check",
    "lint:naming": "./.agents/skills/naming-discipline/scripts/check-naming.sh",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-pipeline.mjs",
    "format": "biome format --write",
    "connectome": "node scripts/generate-connectome.mjs > context/connectome.md",
    "consolidate": "node scripts/consolidate-memory.mjs",
    "pulse": "node scripts/pulse.mjs",
    "logs": "node scripts/logs.mjs",
    "memory": "node scripts/omega-memory.mjs",
    "sca": "node scripts/sca-check.mjs",
    "mcp": "node scripts/omega-mcp-server.mjs",
    "mcp:server": "tsx src/mcp/protokol-mcp-server.ts",
    "doctor": "node scripts/doctor.mjs",
    "checkpoint": "node scripts/checkpoint.mjs create",
    "rollback": "node scripts/checkpoint.mjs rollback",
    "pipedream": "node scripts/pipedream-cli.mjs",
    "corpus:pipeline": "python3 pipelines/dump/corpus_pipeline/orchestrator.py",
    "wikiquote:pipeline": ".venv/bin/python pipelines/dump/wikimedia/wikiquote/orchestrator.py",
    "wikibooks:pipeline": ".venv/bin/python pipelines/dump/wikimedia/wikibooks/orchestrator.py",
    "wikiversity:pipeline": ".venv/bin/python pipelines/dump/wikimedia/wikiversity/orchestrator.py",
    "wikivoyage:pipeline": ".venv/bin/python pipelines/dump/wikimedia/wikivoyage/orchestrator.py",
    "wikisource:pipeline": ".venv/bin/python pipelines/dump/wikimedia/wikisource/orchestrator.py",
    "wiktionary:pipeline": ".venv/bin/python pipelines/dump/wikimedia/wiktionary/orchestrator.py",
    "wikimedia:all:pipeline": ".venv/bin/python pipelines/dump/wikimedia/runners/run_all_wikimedia_pipelines.py",
    "wikinews:pipeline": ".venv/bin/python pipelines/dump/wikimedia/wikinews/orchestrator.py",
    "wikispecies:pipeline": ".venv/bin/python pipelines/dump/wikimedia/wikispecies/orchestrator.py",
    "wikimedia:news-species:pipeline": ".venv/bin/python pipelines/dump/wikimedia/runners/run_news_and_species_pipelines.py",
    "test:wikiquote": ".venv/bin/python -m unittest pipelines/dump/wikimedia/wikiquote/test_wikiquote_pipeline.py",
    "test:wikisource": ".venv/bin/python pipelines/dump/wikimedia/wikisource/test_wikisource_pipeline.py",
    "test:wiktionary": ".venv/bin/python pipelines/dump/wikimedia/wiktionary/test_wiktionary_pipeline.py",
    "test:wikimedia": ".venv/bin/python pipelines/dump/wikimedia/wikibooks/test_wikibooks_pipeline.py && .venv/bin/python pipelines/dump/wikimedia/wikiversity/test_wikiversity_pipeline.py && .venv/bin/python pipelines/dump/wikimedia/wikivoyage/test_wikivoyage_pipeline.py && .venv/bin/python pipelines/dump/wikimedia/wikisource/test_wikisource_pipeline.py && .venv/bin/python pipelines/dump/wikimedia/wiktionary/test_wiktionary_pipeline.py",
    "test:news-species": ".venv/bin/python pipelines/dump/wikimedia/wikinews/test_wikinews_pipeline.py && .venv/bin/python pipelines/dump/wikimedia/wikispecies/test_wikispecies_pipeline.py",
    "test:corpus": "if command -v uv >/dev/null 2>&1; then uv run --with pyarrow --with duckdb --with datasketch python pipelines/dump/corpus_pipeline/test_corpus_pipeline.py; else python3 pipelines/dump/corpus_pipeline/test_corpus_pipeline.py; fi",
    "gutenberg:pipeline": ".venv/bin/python pipelines/dump/gutenberg/orchestrator.py",
    "stackexchange:pipeline": ".venv/bin/python pipelines/dump/stackexchange/orchestrator.py",
    "openalex:pipeline": ".venv/bin/python pipelines/api_stream/openalex/orchestrator.py",
    "openalex:snapshot:pipeline": ".venv/bin/python pipelines/snapshot/openalex/orchestrator.py",
    "semanticscholar:pipeline": ".venv/bin/python pipelines/api_stream/semantic_scholar/orchestrator.py",
    "test:gutenberg": ".venv/bin/python pipelines/dump/gutenberg/test_gutenberg_pipeline.py",
    "test:stackexchange": ".venv/bin/python pipelines/dump/stackexchange/test_stackexchange_pipeline.py",
    "test:openalex": ".venv/bin/python pipelines/api_stream/openalex/test_openalex_pipeline.py",
    "test:openalex:snapshot": ".venv/bin/python -m unittest pipelines/snapshot/openalex/test_snapshot_pipeline.py",
    "test:semanticscholar": ".venv/bin/python pipelines/api_stream/semantic_scholar/test_semanticscholar_pipeline.py",
    "test:shared-pipelines": ".venv/bin/python pipelines/shared/test_shared_pipeline.py",
    "test:corpus-pipelines": ".venv/bin/python pipelines/dump/gutenberg/test_gutenberg_pipeline.py && .venv/bin/python pipelines/dump/stackexchange/test_stackexchange_pipeline.py && .venv/bin/python pipelines/api_stream/openalex/test_openalex_pipeline.py && .venv/bin/python pipelines/snapshot/openalex/test_snapshot_pipeline.py && .venv/bin/python pipelines/api_stream/semantic_scholar/test_semanticscholar_pipeline.py && .venv/bin/python pipelines/shared/test_shared_pipeline.py",
    "make:actor": "node scripts/scaffold-actor.mjs",
    "make:pipeline": ".venv/bin/python scripts/scaffold/scaffold-pipeline.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@mozilla/readability": "^0.6.0",
    "@pipedream/sdk": "^3.1.6",
    "cheerio": "^1.2.0",
    "googleapis": "^182.0.0",
    "js-yaml": "^5.4.2",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
