{
  "name": "protokol-7",
  "version": "1.0.0",
  "private": true,
  "description": "Headless Web Scraping, Deep Crawling & Anti-Detection Browser Automation Microservice",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "test": "NODE_ENV=test tsx --test 'tests/**/*.test.ts'",
    "lint": "biome check",
    "lint:naming": "./.agents/skills/naming-discipline/scripts/check-naming.sh",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-pipeline.mjs",
    "format": "biome format --write",
    "connectome": "node scripts/generate-connectome.mjs > context/connectome.md",
    "consolidate": "node scripts/consolidate-memory.mjs",
    "memory": "node scripts/omega-memory.mjs",
    "sca": "node scripts/sca-check.mjs",
    "mcp": "node scripts/omega-mcp-server.mjs",
    "mcp:server": "tsx src/mcp/protokol-mcp-server.ts",
    "doctor": "node scripts/doctor.mjs",
    "checkpoint": "node scripts/checkpoint.mjs create",
    "rollback": "node scripts/checkpoint.mjs rollback",
    "harvest:ekutuphane": "node scripts/harvest-ekutuphane.mjs",
    "pipedream": "node scripts/pipedream-cli.mjs",
    "wiki:download": "scripts/wikipedia_pipeline/.venv/bin/python scripts/wikipedia_pipeline/downloader.py",
    "trwiki:pipeline": "scripts/wikipedia_pipeline/.venv/bin/python scripts/wikipedia_pipeline/run_pipeline.py",
    "trwiki:multilang": "scripts/wikipedia_pipeline/.venv/bin/python scripts/wikipedia_pipeline/multi_lang_orchestrator.py",
    "bigdata:pipeline": "scripts/wikipedia_pipeline/.venv/bin/python scripts/bigdata_pipeline/orchestrator.py",
    "bigdata:test": "scripts/wikipedia_pipeline/.venv/bin/python scripts/bigdata_pipeline/test_bigdata_pipeline.py"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@pipedream/sdk": "^3.1.6",
    "cheerio": "^1.2.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
